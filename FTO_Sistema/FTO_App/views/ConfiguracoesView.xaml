<UserControl x:Class="FTO_App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="15,10">
            <TextBlock Text="⚙️ Configurações do Sistema" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="{DynamicResource CardBackgroundBrush}">
            <TabItem Header="Empresa">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <WrapPanel>
                        <StackPanel Width="280" Margin="0,0,12,10"><TextBlock Text="Nome (exibição)"/><TextBox x:Name="TxtNome" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="280" Margin="0,0,12,10"><TextBlock Text="Subtítulo"/><TextBox x:Name="TxtSubtitulo" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Razão Social"/><TextBox x:Name="TxtRazao" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="Nome Fantasia"/><TextBox x:Name="TxtFantasia" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="CNPJ"/><TextBox x:Name="TxtCnpj" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,10"><TextBlock Text="IE"/><TextBox x:Name="TxtIe" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,10"><TextBlock Text="IM"/><TextBox x:Name="TxtIm" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,10"><TextBlock Text="CNAE"/><TextBox x:Name="TxtCnae" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,10"><TextBlock Text="Telefone"/><TextBox x:Name="TxtTelefone" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="240" Margin="0,0,12,10"><TextBlock Text="E-mail"/><TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="280" Margin="0,0,12,10"><TextBlock Text="Logradouro"/><TextBox x:Name="TxtEndereco" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="80" Margin="0,0,12,10"><TextBlock Text="Nº"/><TextBox x:Name="TxtNumero" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="160" Margin="0,0,12,10"><TextBlock Text="Complemento"/><TextBox x:Name="TxtComplemento" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="180" Margin="0,0,12,10"><TextBlock Text="Bairro"/><TextBox x:Name="TxtBairro" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="200" Margin="0,0,12,10"><TextBlock Text="Cidade"/><TextBox x:Name="TxtCidade" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="60" Margin="0,0,12,10"><TextBlock Text="UF"/><TextBox x:Name="TxtUf" Style="{StaticResource ModernTextBox}" MaxLength="2"/></StackPanel>
                        <StackPanel Width="110" Margin="0,0,12,10"><TextBlock Text="CEP"/><TextBox x:Name="TxtCep" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Cód. IBGE"/><TextBox x:Name="TxtIbge" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        <TextBlock Width="720" TextWrapping="Wrap" Margin="0,4,12,8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Prestador da NFS-e: CNPJ, IM, e-mail, telefone e endereço desta aba. Com tpEmit=1 o SEFIN usa o cadastro nacional — xNome nunca é enviado; endereço só se ativado em Fiscal → NFS-e."/>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Fiscal / NF-e">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Width="200" Margin="0,0,12,10">
                                <TextBlock Text="Regime tributário"/>
                                <ComboBox x:Name="CbRegime" SelectedIndex="0"
                                          ToolTip="Se o CNPJ NÃO for optante no portal do Simples Nacional, use 3 — Regime Normal (NFS-e: opSimpNac=1). CRT 1/2 sugere ME/EPP e causa SEFIN E0160.">
                                    <ComboBoxItem Content="1 - Simples Nacional" Tag="1"/>
                                    <ComboBoxItem Content="2 - Simples excesso sublimite" Tag="2"/>
                                    <ComboBoxItem Content="3 - Regime Normal" Tag="3"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="Ambiente NF-e"/>
                                <ComboBox x:Name="CbAmbiente" SelectedIndex="1">
                                    <ComboBoxItem Content="1 - Produção" Tag="1"/>
                                    <ComboBoxItem Content="2 - Homologação" Tag="2"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="100" Margin="0,0,12,10"><TextBlock Text="Série NF-e"/><TextBox x:Name="TxtSerieNfe" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Último nº NF-e"/><TextBox x:Name="TxtUltimoNfe" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            <StackPanel Width="100" Margin="0,0,12,10"><TextBlock Text="Série NFS-e"/><TextBox x:Name="TxtSerieNfse" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="Último nº NFS-e"/><TextBox x:Name="TxtUltimoNfse" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="O certificado digital fica cadastrado no Portal da API Fiscal (não é enviado por este app). A geração de XML local (offline) está no módulo Nota Fiscal."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>

                        <TextBlock Text="Integração com a API Fiscal (PFCode) — emissão real" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"
                                   Text="URL base de cada microsserviço (NF-e 55, NFS-e Padrão Nacional) + API Key gerada no Portal Administrativo. A mesma chave serve para homologação e produção — o ambiente é decidido pelo campo Ambiente de cada nota. A chave precisa ter escopo NFSe (ou Full) para emitir NFS-e."/>
                        <WrapPanel>
                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="URL base — NF-e (Fiscal.NFe.API)"/><TextBox x:Name="TxtFiscalUrlNfe" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="URL base — NFS-e (Fiscal.NFSe.API)"/><TextBox x:Name="TxtFiscalUrlNfse" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            <StackPanel Width="320" Margin="0,0,12,10"><TextBlock Text="API Key (X-API-Key)"/><TextBox x:Name="TxtFiscalApiKey" Style="{StaticResource ModernTextBox}"/></StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="🔌 Testar conexão — NF-e" Style="{StaticResource ToolbarButtonStyle}" Click="BtnTestarFiscalNfe_Click"/>
                            <Button Content="🔌 Testar conexão — NFS-e" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnTestarFiscalNfse_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="LblFiscalApiStatus" TextWrapping="Wrap" Margin="0,4,0,12" FontWeight="SemiBold"/>

                        <TextBlock Text="NFS-e — código de tributação nacional (cTribNac)" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"
                                   Text="Código de 6 dígitos da lista nacional de serviços (ex.: 010701 — serviços de TI). Ele é sugerido em toda NFS-e nova. Marque &quot;Fixar&quot; se a empresa presta sempre o mesmo tipo de serviço: o campo passa a ser somente leitura no cadastro e toda nota sai com esse código."/>
                        <WrapPanel>
                            <StackPanel Width="180" Margin="0,0,12,10">
                                <TextBlock Text="cTribNac padrão (6 díg.)"/>
                                <TextBox x:Name="TxtNfseCodTribNac" Style="{StaticResource ModernTextBox}"
                                         MaxLength="6" Text="010101"
                                         ToolTip="Somente dígitos — ex.: 010701 para serviços de TI"/>
                            </StackPanel>
                            <StackPanel Width="380" Margin="0,0,12,10" VerticalAlignment="Bottom">
                                <CheckBox x:Name="ChkNfseCodTribNacFixo"
                                          Content="Fixar este código (bloqueia edição no cadastro da NFS-e)"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="NFS-e — tributos aproximados (Lei 12.741) e opções SEFIN" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"
                                   Text="pTotTrib* entram na DPS quando opSimpNac=1 (não optante). pTotTribMun vazio = usa a alíquota ISS da nota. pAliq e endereço do prestador ficam omitidos por padrão (E0617/E0625/E0128); marque só se o município exigir."/>
                        <WrapPanel>
                            <StackPanel Width="130" Margin="0,0,12,10">
                                <TextBlock Text="pTotTribFed %"/>
                                <TextBox x:Name="TxtNfsePTotFed" Style="{StaticResource ModernTextBox}" Text="13,45"/>
                            </StackPanel>
                            <StackPanel Width="130" Margin="0,0,12,10">
                                <TextBlock Text="pTotTribEst %"/>
                                <TextBox x:Name="TxtNfsePTotEst" Style="{StaticResource ModernTextBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,10">
                                <TextBlock Text="pTotTribMun % (opc.)"/>
                                <TextBox x:Name="TxtNfsePTotMun" Style="{StaticResource ModernTextBox}"
                                         ToolTip="Deixe em branco para usar a alíquota ISS da NFS-e"/>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Margin="0,0,0,12">
                            <CheckBox x:Name="ChkNfseEnviarPAliq" Content="Enviar pAliq na DPS (força; ignore regras E0617/E0625)"
                                      Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkNfseEnviarEndPrest" Content="Enviar endereço do prestador na DPS (risco E0128 com tpEmit=1)"/>
                        </StackPanel>

                        <TextBlock Text="Identificação do emitente — Logo (somente NF-e)" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"
                                   Text="A logo aparece no PDF da DANFE da NF-e (modelo 55). Não é usada no cupom de vendas."/>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Selecionar..." Width="100" Margin="0,0,6,0"
                                        Click="BtnLogo_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                                <Button Content="Remover" Width="80"
                                        Click="BtnRemoverLogo_Click" Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTip="Remove a logo configurada"/>
                            </StackPanel>
                            <TextBox x:Name="TxtLogoPathFiscal" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/>
                        </DockPanel>
                        <Border Width="160" Height="80" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                            <Image x:Name="ImgLogoFiscal" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="IBS / CBS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Reforma tributária (EC 132/2023 · LC 214/2025)" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"
                                   Text="2026: fase de teste — CBS 0,9% + IBS UF 0,1% (pIBSMun=0). A SEFAZ rejeita pIBSUF≠0,1% (rejeição 1026). Sem efeito arrecadatório real. Em 2027–2028 a CBS entra em alíquota cheia (reduzida em 0,1 p.p.) e o IBS passa a 0,05% estadual + 0,05% municipal; a partir de 2029 começa a transição até 2033. A emissão aplica essas regras automaticamente pelo ano da nota — só a alíquota cheia da CBS precisa ser confirmada aqui."/>
                        <WrapPanel>
                            <StackPanel Width="360" Margin="0,0,12,10">
                                <TextBlock Text="Preset de alíquotas"/>
                                <ComboBox x:Name="CbIbsCbsPreset" SelectionChanged="CbIbsCbsPreset_Changed">
                                    <ComboBoxItem Content="Teste 2026 (CBS 0,9% + IBS UF 0,1%)" Tag="teste2026"/>
                                    <ComboBoxItem Content="Projetado cheio (~CBS 9,21% + IBS 18,7%)" Tag="projetado"/>
                                    <ComboBoxItem Content="Personalizado" Tag="personalizado"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,10" VerticalAlignment="Bottom">
                                <CheckBox x:Name="ChkIbsCbsAuto" Content="Cálculo automático" IsChecked="True"/>
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,12,10" VerticalAlignment="Bottom">
                                <CheckBox x:Name="ChkIbsCbsDestaque" Content="Destacar em NF-e / produtos" IsChecked="True"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Alíquotas personalizadas (%)" FontWeight="SemiBold" Margin="0,8,0,6"/>
                        <WrapPanel>
                            <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="CBS %"/><TextBox x:Name="TxtCbsAliq" Style="{StaticResource ModernTextBox}" Text="0,9"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="IBS %"/><TextBox x:Name="TxtIbsAliq" Style="{StaticResource ModernTextBox}" Text="0,1"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="IBS UF %"/><TextBox x:Name="TxtIbsUfAliq" Style="{StaticResource ModernTextBox}" Text="0,1"/></StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,10"><TextBlock Text="IBS Mun %"/><TextBox x:Name="TxtIbsMunAliq" Style="{StaticResource ModernTextBox}" Text="0"/></StackPanel>
                        </WrapPanel>
                        <Border Background="#E8EEF5" Padding="12" CornerRadius="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Simulação (base R$ 1.000,00)" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="#1B1B1B"/>
                                <TextBlock x:Name="LblIbsCbsSimulacao" TextWrapping="Wrap" Foreground="#1B1B1B"/>
                                <TextBlock x:Name="LblCbsCheiaAlerta" TextWrapping="Wrap" Margin="0,8,0,0"
                                           FontWeight="SemiBold" Foreground="#8A4B00"/>
                                <Button Content="↻ Recalcular simulação" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource ToolbarButtonStyle}" Click="BtnSimularIbsCbs_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Cupom">
                <StackPanel Margin="14">
                    <TextBlock Text="Comprovante de vendas (térmica)" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"
                               Text="Textos do cupom não fiscal. A logo do emitente fica só em Fiscal / NF-e (DANFE modelo 55)."/>
                    <TextBlock Text="Título do cupom"/><TextBox x:Name="TxtCupomTitulo" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" Width="400" HorizontalAlignment="Left"/>
                    <TextBlock Text="Rodapé do cupom"/><TextBox x:Name="TxtCupomRodape" Style="{StaticResource ModernTextBox}" Width="400" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Banco de dados">
                <StackPanel Margin="14">
                    <TextBlock Text="PostgreSQL (pgAdmin)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{DynamicResource TitleBrush}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Configure PGHOST, PGPORT, PGDATABASE, PGUSER e PGPASSWORD no arquivo .env (só conexão). Empresa, série e ambiente ficam no banco — edite nas abas acima. Crie o banco &quot;fto&quot; no pgAdmin."/>
                    <TextBlock x:Name="LblPgStatus" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Migração do SQLite antigo (FTO.db)" FontWeight="Bold" Margin="0,8,0,6"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Copia Users, Clientes, Vendas, Produtos, Notas e Integrações do FTO.db (pasta do app) para o PostgreSQL, sem apagar o arquivo SQLite. Também preenche CPF/CNPJ nas vendas a partir do cadastro de clientes."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔄 Testar conexão PostgreSQL" Style="{StaticResource ToolbarButtonStyle}"
                                Click="BtnTestPg_Click" Margin="0,0,8,0"/>
                        <Button Content="📦 Migrar dados do SQLite → PostgreSQL" Style="{StaticResource HoverButtonStyle}"
                                Width="280" Click="BtnMigrarSqlite_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LblSqlitePath" Margin="0,12,0,0" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Backup">
                <StackPanel Margin="14">
                    <TextBlock Text="Backup completo no servidor" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{DynamicResource TitleBrush}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Gera o dump do PostgreSQL e copia .env, configurações de dispositivos, XMLs de NF-e, certificado digital e logo para o servidor da rede. As pastas são criadas por mês e dia — ex.: Setembro-2026\09-09-2026\143025."/>

                    <Border Padding="10" Margin="0,0,0,12" CornerRadius="4"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="LblBackupDestino" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                            <TextBlock x:Name="LblBackupPgDump" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="BtnBackupAgora" Content="🗄️ Realizar backup do sistema"
                                Style="{StaticResource HoverButtonStyle}" Width="260"
                                Click="BtnBackupAgora_Click"/>
                        <Button Content="📂 Abrir pasta de backups" Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0" Click="BtnAbrirPastaBackup_Click"/>
                        <Button Content="↻ Reler .env" Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0" Click="BtnRecarregarBackup_Click"/>
                    </StackPanel>

                    <TextBox x:Name="TxtBackupLog" Margin="0,12,0,0" Height="240"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True" Visibility="Collapsed"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="{DynamicResource CardBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Dispositivos">
                <StackPanel Margin="14">
                    <TextBlock Text="Impressora térmica" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CbImpressora" Width="400" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="Scanner" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CbScanner" Width="400" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="↻ Atualizar dispositivos" Click="BtnRefreshDevices_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                        <Button Content="🔎 Diagnóstico da impressora" Click="BtnDiagnosticoImpressora_Click"
                                Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0"
                                ToolTip="Mostra o tamanho de papel e a área imprimível que o driver declara — use para comparar a fila USB com a de rede quando o cupom sair cortado."/>
                    </StackPanel>
                    <TextBox x:Name="TxtDiagnosticoImpressora" Margin="0,12,0,0" Height="260"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True" Visibility="Collapsed"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Background="{DynamicResource CardBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="12" Background="{DynamicResource CardBackgroundBrush}" Margin="10,0,10,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock x:Name="LblEnvPath" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="💾 SALVAR CONFIGURAÇÕES" Style="{StaticResource HoverButtonStyle}"
                        Width="200" Click="BtnSalvar_Click" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
