<UserControl x:Class="FTO_App.Views.NotaServicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="15,10">
            <TextBlock Text="🛠️ NFS-e (Padrão Nacional)" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="10" Margin="10,10,10,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtBusca" Width="240" Style="{StaticResource ModernTextBox}"
                         ToolTip="Buscar tomador ou número" TextChanged="TxtBusca_TextChanged"/>
                <ComboBox x:Name="CbFiltroStatus" Width="130" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Todos status"/>
                    <ComboBoxItem Content="Rascunho" Tag="Rascunho"/>
                    <ComboBoxItem Content="Emitida" Tag="Emitida"/>
                    <ComboBoxItem Content="Rejeitada" Tag="Rejeitada"/>
                    <ComboBoxItem Content="Cancelada" Tag="Cancelada"/>
                </ComboBox>
                <Button Content="🔍 Filtrar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnFiltrar_Click"/>
                <Button Content="+ Nova NFS-e" Style="{StaticResource HoverButtonStyle}" Width="120" Margin="8,0,0,0" Click="BtnNovo_Click"/>
                <Button Content="✏️ Editar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnEditar_Click"/>
                <Button Content="🚀 Emitir NFS-e" Style="{StaticResource HoverButtonStyle}" Margin="8,0,0,0" Click="BtnAcoes_Click"
                        ToolTip="Abrir janela de emissão, XML, DANFSE e cancelamento"/>
                <Button Content="🗑️ Excluir" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                        BorderThickness="0" Padding="10,5" Margin="8,0,0,0" Click="BtnExcluir_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="GridNotas" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick"
                          Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº DPS" Binding="{Binding NumeroExibicao}" Width="80"/>
                        <DataGridTextColumn Header="Competência" Binding="{Binding DataCompetenciaFormatada}" Width="100"/>
                        <DataGridTextColumn Header="Tomador" Binding="{Binding TomadorNome}" Width="*"/>
                        <DataGridTextColumn Header="Serviço" Binding="{Binding DescricaoServico}" Width="180"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorFormatado}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Chave" Binding="{Binding ChaveAcesso}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content=" Anterior " Click="BtnPrev_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="LblPageInfo" Text="Pág 1/1" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Content=" Próxima " Click="BtnNext_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             Cadastro / edição da NFS-e (DPS)
             ============================================================ -->
        <Grid x:Name="FormOverlay" Grid.RowSpan="3" Background="#8C0F172A" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Background="{StaticResource FormCanvasBrush}" Margin="36,22" CornerRadius="10"
                    MaxWidth="1100" MaxHeight="900" ClipToBounds="True">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="26,16,16,16"
                            CornerRadius="10,10,0,0" BorderBrush="{StaticResource FormCardBorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="36" Click="BtnFecharForm_Click"
                                    Style="{StaticResource RowIconButtonStyle}" FontSize="15" VerticalAlignment="Top"
                                    Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="Fechar sem salvar"/>
                            <Border x:Name="BadgeAmbienteNfse" DockPanel.Dock="Right" CornerRadius="12" Padding="12,4"
                                    Margin="0,0,12,0" VerticalAlignment="Center" Background="#FEF3C7">
                                <TextBlock x:Name="LblBadgeAmbienteNfse" Text="HOMOLOGAÇÃO" FontSize="11" FontWeight="Bold"
                                           Foreground="#B45309"/>
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="LblFormTitulo" Text="Cadastrar NFS-e" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}"/>
                                <TextBlock Text="Padrão Nacional · Declaração de Prestação de Serviço (DPS)"
                                           Style="{StaticResource FormSectionSubtitle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,18,26,6">
                        <StackPanel>

                            <!-- 1. Identificação da DPS -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="1" Style="{StaticResource FormStepText}"/></Border>
                                        <TextBlock Text="Identificação da DPS" Style="{StaticResource FormSectionTitle}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="Ambiente SEFIN *" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbAmbiente" SelectedIndex="0" SelectionChanged="CbAmbienteNfse_SelectionChanged"
                                                      ToolTip="Produção restrita (sandbox da API) exige tpAmb=2. Só use Produção (1) se a Fiscal.NFSe.API estiver com AmbienteRestrito=false.">
                                                <ComboBoxItem Content="2 — Homologação (produção restrita)" Tag="2"/>
                                                <ComboBoxItem Content="1 — Produção nacional" Tag="1"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="Série *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtSerie" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Nº DPS *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtNumeroDps" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Competência *" Style="{StaticResource FormLabel}"/>
                                            <DatePicker x:Name="DpCompetencia"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="IBGE emissão *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtIbgeEmissao" Style="{StaticResource ModernTextBox}" MaxLength="7"
                                                     ToolTip="cLocEmi — 7 dígitos"/>
                                            <TextBlock Text="cLocEmi · 7 dígitos" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Tomador -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="2" Style="{StaticResource FormStepText}"/></Border>
                                        <TextBlock Text="Tomador do serviço" Style="{StaticResource FormSectionTitle}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Cliente cadastrado" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbCliente" DisplayMemberPath="Nome" IsEditable="True" IsTextSearchEnabled="True"
                                                      SelectionChanged="CbCliente_Changed"
                                                      ToolTip="Digite para localizar — preenche os dados do tomador"/>
                                            <TextBlock Text="Opcional — preenche os campos abaixo" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Nome / Razão social *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorNome" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="CPF / CNPJ *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorDoc" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Text="O CNPJ precisa existir na Receita Federal" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="E-mail" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorEmail" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Telefone" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorFone" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="CEP" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorCep" Style="{StaticResource ModernTextBox}"
                                                     KeyDown="TxtTomadorCep_KeyDown"
                                                     ToolTip="Pressione Enter para buscar o endereço (ViaCEP)"/>
                                            <TextBlock Text="Enter preenche o endereço" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Logradouro" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorLgr" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="Número" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorNro" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="5" Style="{StaticResource FormField}">
                                            <TextBlock Text="Bairro" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorBairro" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Município" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorMun" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="UF" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorUf" Style="{StaticResource ModernTextBox}" MaxLength="2" CharacterCasing="Upper"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="Código IBGE" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtTomadorIbge" Style="{StaticResource ModernTextBox}" MaxLength="7"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Serviço -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="3" Style="{StaticResource FormStepText}"/></Border>
                                        <TextBlock Text="Serviço prestado" Style="{StaticResource FormSectionTitle}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock x:Name="LblCodTribNac" Text="cTribNac (6 díg.) *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtCodTribNac" Style="{StaticResource ModernTextBox}" MaxLength="6"
                                                     ToolTip="Lista Nacional — ex.: 010101"/>
                                            <TextBlock Text="Código da Lista Nacional" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="cTribMun" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtCodTribMun" Style="{StaticResource ModernTextBox}"/>
                                            <TextBlock Text="Código municipal (opcional)" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="IBGE prestação *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtIbgePrestacao" Style="{StaticResource ModernTextBox}" MaxLength="7"/>
                                            <TextBlock Text="Município da prestação" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="NBS (9 díg.)" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtCodNbs" Style="{StaticResource ModernTextBox}" MaxLength="9"
                                                     ToolTip="Obrigatório se incluir IBS/CBS"/>
                                            <TextBlock Text="Obrigatório com IBS/CBS" Style="{StaticResource FormHint}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="Descrição do serviço *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDescServico" Style="{StaticResource ModernTextBox}" Height="66"
                                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                                     Padding="6,6" MaxLength="2000"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. Valores e ISS -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="4" Style="{StaticResource FormStepText}"/></Border>
                                        <TextBlock Text="Valores e ISSQN" Style="{StaticResource FormSectionTitle}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="Valor do serviço (R$) *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtValorServico" Style="{StaticResource ModernTextBox}" FontWeight="SemiBold"
                                                     TextChanged="TxtValorServico_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="Tributação do ISSQN *" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbTribIssqn" SelectedIndex="0">
                                                <ComboBoxItem Content="1 — Operação tributável" Tag="1"/>
                                                <ComboBoxItem Content="2 — Exportação" Tag="2"/>
                                                <ComboBoxItem Content="3 — Não incidência" Tag="3"/>
                                                <ComboBoxItem Content="4 — Imunidade" Tag="4"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Retenção do ISS *" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbTpRetIssqn" SelectedIndex="0">
                                                <ComboBoxItem Content="1 — Não retido" Tag="1"/>
                                                <ComboBoxItem Content="2 — Retido pelo tomador" Tag="2"/>
                                                <ComboBoxItem Content="3 — Retido pelo intermediário" Tag="3"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Alíquota ISS %" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtAliqIss" Style="{StaticResource ModernTextBox}" Text="5"
                                                     ToolTip="Com município ATIVO no Sistema Nacional a SEFIN não aceita pAliq (E0617 não-optante / E0625 ME-EPP). O campo fica só para referência / pTotTrib."/>
                                            <TextBlock Text="Referência — a SEFIN pode ignorar" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 5. Regime do prestador -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="5" Style="{StaticResource FormStepText}"/></Border>
                                        <TextBlock Text="Regime do prestador" Style="{StaticResource FormSectionTitle}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource FormSectionSubtitle}" Margin="34,0,0,14"
                                               Text="Precisa bater com o cadastro do CNPJ no Simples Nacional na competência (SEFIN E0160)."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="Opção pelo Simples" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbOpSimpNac" SelectedIndex="0"
                                                      ToolTip="opSimpNac — deve bater com o cadastro do CNPJ no Simples Nacional na competência (SEFIN E0160)">
                                                <ComboBoxItem Content="1 — Não optante" Tag="1"/>
                                                <ComboBoxItem Content="2 — MEI" Tag="2"/>
                                                <ComboBoxItem Content="3 — ME/EPP (Simples)" Tag="3"/>
                                            </ComboBox>
                                            <TextBlock Text="opSimpNac" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="Apuração no Simples" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbRegApTribSN" SelectedIndex="0"
                                                      ToolTip="regApTribSN — SEFIN E0166: obrigatório quando opSimpNac = 3 (ME/EPP)">
                                                <ComboBoxItem Content="1 — Tributos federais e municipal pelo SN" Tag="1"/>
                                                <ComboBoxItem Content="2 — Federais pelo SN; ISSQN fora do SN" Tag="2"/>
                                                <ComboBoxItem Content="3 — Federais e municipal fora do SN" Tag="3"/>
                                            </ComboBox>
                                            <TextBlock Text="regApTribSN · obrigatório para ME/EPP" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Regime especial" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtRegEspTrib" Style="{StaticResource ModernTextBox}" Text="0"/>
                                            <TextBlock Text="regEspTrib · 0 = nenhum" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 6. IBS / CBS -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <CheckBox x:Name="ChkIbsCbs" DockPanel.Dock="Right" Content="Incluir classificação IBS/CBS"
                                                  VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="6" Style="{StaticResource FormStepText}"/></Border>
                                            <TextBlock Text="IBS / CBS (opcional)" Style="{StaticResource FormSectionTitle}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="CST" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtCstIbsCbs" Style="{StaticResource ModernTextBox}" Text="000" MaxLength="3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="cClassTrib" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtClassTrib" Style="{StaticResource ModernTextBox}" Text="000001" MaxLength="6"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="cIndOp" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtCodIndOp" Style="{StaticResource ModernTextBox}" Text="000001" MaxLength="6"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource FormCardBorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,0,12,10">
                                        <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="11.5"
                                                   Text="O prestador vem das Configurações (CNPJ; IM só se real). Com tpEmit=1 não enviamos xNome nem endereço do prestador (SEFIN E0121/E0128)."/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="26,14"
                            CornerRadius="0,0,10,10" BorderBrush="{StaticResource FormCardBorderBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="VALOR DO SERVIÇO" Style="{StaticResource TotalLabel}"/>
                                <TextBlock x:Name="LblResumoValorNfse" Text="R$ 0,00" FontSize="21" FontWeight="Bold"
                                           Foreground="{DynamicResource TitleBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                        Click="BtnFecharForm_Click"/>
                                <Button Content="💾  Salvar NFS-e" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSalvar_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
