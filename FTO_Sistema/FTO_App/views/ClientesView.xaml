<UserControl x:Class="FTO_App.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="15,10">
            <TextBlock Text="👤 Clientes" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="10" Margin="10,10,10,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtBusca" Width="220" Style="{StaticResource ModernTextBox}"
                         ToolTip="Buscar nome, documento ou município" TextChanged="TxtBusca_TextChanged"/>
                <ComboBox x:Name="CbFiltroTipo" Width="130" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Todos os tipos"/>
                    <ComboBoxItem Content="Pessoa Física" Tag="F"/>
                    <ComboBoxItem Content="Pessoa Jurídica" Tag="J"/>
                </ComboBox>
                <ComboBox x:Name="CbFiltroStatus" Width="110" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Ativos" Tag="1"/>
                    <ComboBoxItem Content="Inativos" Tag="0"/>
                </ComboBox>
                <Button Content="🔍 Filtrar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnFiltrar_Click"/>
                <Button Content="+ Cadastrar cliente" Style="{StaticResource HoverButtonStyle}" Width="150" Margin="8,0,0,0" Click="BtnNovo_Click"/>
                <Button Content="✏️ Editar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnEditar_Click"/>
                <Button Content="🗑️ Excluir" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                        BorderThickness="0" Padding="10,5" Margin="8,0,0,0" Click="BtnExcluirLista_Click"/>
                <Button Content="💾 Backup" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnBackup_Click"/>
                <Button Content="📄 PDF" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnPdf_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="GridClientes" Margin="0" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick"
                          Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0"
                          RowHeight="26" AlternationCount="2"
                          AlternatingRowBackground="{DynamicResource GridAltRowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoPessoaExibicao}" Width="80"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="CPF/CNPJ" Binding="{Binding CpfCnpj}" Width="140"/>
                        <DataGridTextColumn Header="IE" Binding="{Binding Ie}" Width="90"/>
                        <DataGridTextColumn Header="Município" Binding="{Binding Municipio}" Width="120"/>
                        <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="40"/>
                        <DataGridTextColumn Header="IBGE" Binding="{Binding CodigoIbge}" Width="80"/>
                        <DataGridTextColumn Header="Contato" Binding="{Binding Contato}" Width="110"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusAtivo}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content=" Anterior " Click="BtnPrev_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="LblPageInfo" Text="Pág 1/1" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Content=" Próxima " Click="BtnNext_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Modal cadastro -->
        <Grid x:Name="FormOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Background="{DynamicResource CardBackgroundBrush}" Margin="40,30" CornerRadius="8" Padding="18"
                    MaxWidth="920" VerticalAlignment="Center" MaxHeight="640">
                <Border.Effect><DropShadowEffect BlurRadius="24"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="LblFormTitulo" Text="Cadastrar cliente" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}"/>
                        <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="28" Click="BtnFecharForm_Click"
                                Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"
                                Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="140" Margin="0,0,10,8">
                                    <TextBlock Text="Tipo" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CbTipoPessoa" SelectedIndex="0"
                                              ToolTip="Sem CPF/CNPJ: escolha se é pessoa física ou jurídica">
                                        <ComboBoxItem Content="Física" Tag="F"/>
                                        <ComboBoxItem Content="Jurídica" Tag="J"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,8">
                                    <TextBlock Text="Nome / Nome completo *" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtNome" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,8">
                                    <TextBlock Text="Razão Social" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtRazaoSocial" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,8">
                                    <TextBlock Text="Nome Fantasia" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtNomeFantasia" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,8">
                                    <TextBlock Text="CPF / CNPJ (opcional)" Margin="0,0,0,2"/>
                                    <DockPanel>
                                        <Button Content="Buscar CNPJ" DockPanel.Dock="Right" Width="100" Margin="6,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Click="BtnBuscarDocumento_Click"
                                                ToolTip="Consulta CNPJ nos Dados Abertos da Receita Federal (preenche razão social e endereço)."/>
                                        <TextBox x:Name="TxtCpfCnpj" Style="{StaticResource ModernTextBox}"
                                                 LostFocus="TxtCpfCnpj_LostFocus" TextChanged="TxtCpfCnpj_TextChanged"
                                                 KeyDown="TxtCpfCnpj_KeyDown"/>
                                    </DockPanel>
                                    <TextBlock x:Name="LblDocStatus" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8">
                                    <TextBlock Text="IE" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtIe" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8">
                                    <TextBlock Text="IM" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtIm" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,8">
                                    <TextBlock Text="Indicador IE" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CbIndicadorIe" SelectedIndex="2">
                                        <ComboBoxItem Content="1 - Contribuinte" Tag="1"/>
                                        <ComboBoxItem Content="2 - Isento" Tag="2"/>
                                        <ComboBoxItem Content="9 - Não contribuinte" Tag="9"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8">
                                    <TextBlock Text="Telefone / Contato" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtContato" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="240" Margin="0,0,10,8">
                                    <TextBlock Text="E-mail" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Endereço" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,8"/>
                            <TextBlock Text="Digite o CEP e pressione Enter para preencher automaticamente"
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <StackPanel Width="120" Margin="0,0,10,8">
                                    <TextBlock Text="CEP" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtCep" Style="{StaticResource ModernTextBox}"
                                             KeyDown="TxtCep_KeyDown"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,10,8">
                                    <TextBlock Text="Logradouro" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtLogradouro" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8">
                                    <TextBlock Text="Número" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtNumero" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8">
                                    <TextBlock Text="Complemento" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtComplemento" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,8">
                                    <TextBlock Text="Bairro" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtBairro" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="200" Margin="0,0,10,8">
                                    <TextBlock Text="Município" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtMunicipio" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="70" Margin="0,0,10,8">
                                    <TextBlock Text="UF" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtUf" Style="{StaticResource ModernTextBox}" MaxLength="2"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8">
                                    <TextBlock Text="Cód. IBGE *" Margin="0,0,0,2" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtCodigoIbge" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8">
                                    <TextBlock Text="País" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtPais" Style="{StaticResource ModernTextBox}" Text="Brasil"/>
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8">
                                    <TextBlock Text="Cód. País" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtCodigoPais" Style="{StaticResource ModernTextBox}" Text="1058"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancelar" Margin="0,0,8,0" Padding="14,6" Click="BtnFecharForm_Click"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <Button x:Name="BtnSalvar" Content="💾 SALVAR" Style="{StaticResource HoverButtonStyle}"
                                Width="140" Click="BtnSalvar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
