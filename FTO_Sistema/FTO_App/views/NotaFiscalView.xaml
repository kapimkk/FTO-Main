<UserControl x:Class="FTO_App.Views.NotaFiscalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="15,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧾 Nota Fiscal (NF-e)" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="  · XML local" Foreground="#cbd5e1" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="10" Margin="10,10,10,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtBusca" Width="240" Style="{StaticResource ModernTextBox}"
                         ToolTip="Buscar destinatário ou número" TextChanged="TxtBusca_TextChanged"/>
                <ComboBox x:Name="CbFiltroStatus" Width="130" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Todos status"/>
                    <ComboBoxItem Content="Rascunho" Tag="Rascunho"/>
                    <ComboBoxItem Content="XML gerado" Tag="XML gerado"/>
                    <ComboBoxItem Content="Emitida" Tag="Emitida"/>
                    <ComboBoxItem Content="Rejeitada" Tag="Rejeitada"/>
                    <ComboBoxItem Content="Cancelada" Tag="Cancelada"/>
                </ComboBox>
                <Button Content="🔍 Filtrar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnFiltrar_Click"/>
                <Button Content="+ Nova NF-e" Style="{StaticResource HoverButtonStyle}" Width="105" Margin="8,0,0,0" Click="BtnNovoNfe_Click"
                        ToolTip="Nota fiscal eletrônica — operações entre empresas (B2B)"/>
                <Button Content="✏️ Editar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnEditar_Click"/>
                <Button Content="⚡ Ações fiscais" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnAcoesFiscais_Click"
                        ToolTip="Emitir, consultar, cancelar, baixar XML/DANFE e carta de correção"/>
                <Button Content="🗑️ Excluir" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                        BorderThickness="0" Padding="10,5" Margin="8,0,0,0" Click="BtnExcluirLista_Click"/>
                <Button Content="🚫 Inutilizar numeração" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnInutilizar_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="GridNotas" Margin="0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick"
                          Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Modelo" Binding="{Binding ModeloExibicao}" Width="70"/>
                        <DataGridTextColumn Header="Nº" Binding="{Binding NumeroExibicao}" Width="70"/>
                        <DataGridTextColumn Header="Emissão" Binding="{Binding DataEmissaoFormatada}" Width="120"/>
                        <DataGridTextColumn Header="Destinatário" Binding="{Binding DestNome}" Width="*"/>
                        <DataGridTextColumn Header="Itens" Binding="{Binding ResumoItens}" Width="200"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding ValorTotalFormatado}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Situação SEFAZ" Binding="{Binding SituacaoFiscalExibicao}" Width="220"/>
                        <DataGridTextColumn Header="XML" Binding="{Binding CaminhoXml}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content=" Anterior " Click="BtnPrev_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="LblPageInfo" Text="Pág 1/1" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Content=" Próxima " Click="BtnNext_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             Cadastro / edição da NF-e
             ============================================================ -->
        <Grid x:Name="FormOverlay" Grid.RowSpan="3" Background="#8C0F172A" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Background="{StaticResource FormCanvasBrush}" Margin="36,22" CornerRadius="10"
                    MaxWidth="1180" MaxHeight="900" ClipToBounds="True">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="26,16,16,16"
                            CornerRadius="10,10,0,0" BorderBrush="{StaticResource FormCardBorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="36" Click="BtnFecharForm_Click"
                                    Style="{StaticResource RowIconButtonStyle}" FontSize="15" VerticalAlignment="Top"
                                    Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="Fechar sem salvar"/>
                            <Border x:Name="BadgeAmbiente" DockPanel.Dock="Right" CornerRadius="12" Padding="12,4"
                                    Margin="0,0,12,0" VerticalAlignment="Center" Background="#FEF3C7">
                                <TextBlock x:Name="LblBadgeAmbiente" Text="HOMOLOGAÇÃO" FontSize="11" FontWeight="Bold"
                                           Foreground="#B45309"/>
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="LblFormTitulo" Text="Cadastrar NF-e" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}"/>
                                <TextBlock x:Name="LblFormSubtitulo" Text="Modelo 55" Style="{StaticResource FormSectionSubtitle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,18,26,6">
                        <StackPanel>

                            <!-- 1. Identificação -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="1" Style="{StaticResource FormStepText}"/></Border>
                                        <TextBlock Text="Identificação da nota" Style="{StaticResource FormSectionTitle}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Natureza da operação *" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbNatOp" IsEditable="True" SelectedIndex="0"
                                                      ToolTip="Texto livre enviado em natOp (máx. 60 caracteres). Não é CFOP — o CFOP fica em cada item.">
                                                <ComboBoxItem Content="Venda de mercadoria"/>
                                                <ComboBoxItem Content="Venda a consumidor final"/>
                                                <ComboBoxItem Content="Prestação de serviço"/>
                                                <ComboBoxItem Content="Devolução de mercadoria"/>
                                                <ComboBoxItem Content="Remessa para demonstração"/>
                                                <ComboBoxItem Content="Bonificação"/>
                                            </ComboBox>
                                            <TextBlock Text="Descrição da operação — o CFOP é informado em cada item" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Série / Número" Style="{StaticResource FormLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtSerie" Style="{StaticResource ModernTextBox}" Text="1"/>
                                                <TextBox x:Name="TxtNumero" Grid.Column="2" Style="{StaticResource ModernTextBox}"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Data de emissão" Style="{StaticResource FormLabel}"/>
                                            <DatePicker x:Name="DpEmissao"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="Ambiente" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbAmbiente" SelectedIndex="1" IsEnabled="False" SelectionChanged="CbAmbiente_SelectionChanged"
                                                      ToolTip="Definido em Configurações → Fiscal / NF-e. Para mudar, altere lá — passa a valer em toda nota nova.">
                                                <ComboBoxItem Content="1 — Produção" Tag="1"/>
                                                <ComboBoxItem Content="2 — Homologação" Tag="2"/>
                                            </ComboBox>
                                            <TextBlock Text="Em Configurações → Fiscal" Style="{StaticResource FormHint}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="Tipo" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbTipoOp" SelectedIndex="1">
                                                <ComboBoxItem Content="0 — Entrada" Tag="0"/>
                                                <ComboBoxItem Content="1 — Saída" Tag="1"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="Finalidade" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbFinalidade" SelectedIndex="0">
                                                <ComboBoxItem Content="1 — Normal" Tag="1"/>
                                                <ComboBoxItem Content="2 — Complementar" Tag="2"/>
                                                <ComboBoxItem Content="3 — Ajuste" Tag="3"/>
                                                <ComboBoxItem Content="4 — Devolução" Tag="4"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Destino da operação" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbIdDest" SelectedIndex="0"
                                                      ToolTip="Sugerido pelo CFOP do 1º item e pela UF do destinatário.">
                                                <ComboBoxItem Content="1 — Interna" Tag="1"/>
                                                <ComboBoxItem Content="2 — Interestadual" Tag="2"/>
                                                <ComboBoxItem Content="3 — Exterior" Tag="3"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel x:Name="PanelIndFinal" Grid.Row="1" Grid.Column="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Consumidor final" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbIndFinal" SelectedIndex="1">
                                                <ComboBoxItem Content="0 — Não" Tag="0"/>
                                                <ComboBoxItem Content="1 — Sim" Tag="1"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel x:Name="PanelIndPres" Grid.Row="1" Grid.Column="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="Presença do comprador" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbIndPres" SelectedIndex="1">
                                                <ComboBoxItem Content="0 — Não se aplica" Tag="0"/>
                                                <ComboBoxItem Content="1 — Presencial" Tag="1"/>
                                                <ComboBoxItem Content="2 — Internet" Tag="2"/>
                                                <ComboBoxItem Content="3 — Teleatendimento" Tag="3"/>
                                                <ComboBoxItem Content="9 — Outros" Tag="9"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="LblHomologHint" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="6" Padding="10,7" Margin="0,0,12,10">
                                        <TextBlock FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap"
                                                   Text="Homologação: o nome do destinatário e a descrição do 1º item são substituídos pelo texto padrão da SEFAZ ao gerar o XML/emitir. Os demais itens seguem como digitados."/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 2. Destinatário -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="2" Style="{StaticResource FormStepText}"/></Border>
                                            <TextBlock Text="Destinatário" Style="{StaticResource FormSectionTitle}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Cliente cadastrado" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbCliente" DisplayMemberPath="Nome" IsEditable="True" IsTextSearchEnabled="True"
                                                      SelectionChanged="CbCliente_SelectionChanged"
                                                      ToolTip="Digite para localizar — preenche todos os dados do destinatário"/>
                                            <TextBlock Text="Opcional — preenche os campos abaixo" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Nome / Razão social *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestNome" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="CPF / CNPJ *" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestDoc" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel x:Name="PanelIndIEDest" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="Indicador de IE" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbIndIEDest" SelectedIndex="2" SelectionChanged="CbIndIEDest_SelectionChanged">
                                                <ComboBoxItem Content="1 — Contribuinte" Tag="1"/>
                                                <ComboBoxItem Content="2 — Isento" Tag="2"/>
                                                <ComboBoxItem Content="9 — Não contribuinte" Tag="9"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel x:Name="PanelDestIe" Grid.Row="1" Grid.Column="2" Style="{StaticResource FormField}">
                                            <TextBlock Text="Inscrição estadual" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestIe" Style="{StaticResource ModernTextBox}" TextChanged="TxtDestIe_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="E-mail" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestEmail" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="CEP" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestCep" Style="{StaticResource ModernTextBox}" KeyDown="TxtDestCep_KeyDown"
                                                     ToolTip="Digite o CEP e pressione Enter para preencher endereço e IBGE (ViaCEP)."/>
                                            <TextBlock Text="Enter preenche o endereço" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Logradouro" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestLgr" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="Número" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestNro" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="5" Style="{StaticResource FormField}">
                                            <TextBlock Text="Bairro" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestBairro" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="Município" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestMun" Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="3" Style="{StaticResource FormField}">
                                            <TextBlock Text="UF" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestUf" Style="{StaticResource ModernTextBox}" MaxLength="2"
                                                     CharacterCasing="Upper" TextChanged="TxtDestUf_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="4" Style="{StaticResource FormField}">
                                            <TextBlock Text="Código IBGE" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtDestIbge" Style="{StaticResource ModernTextBox}" MaxLength="7"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Itens -->
                            <Border Style="{StaticResource FormSectionCard}" Padding="18,14,18,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="📦  Do estoque" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                    Click="BtnItemDoEstoque_Click"
                                                    ToolTip="Escolhe um produto do Estoque e já abre o item preenchido para informar a quantidade."/>
                                            <Button Content="＋  Adicionar item" Style="{StaticResource AccentButtonStyle}"
                                                    Click="BtnAdicionarItem_Click"
                                                    ToolTip="Abre o editor de item — Enter salva e já abre o próximo."/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="3" Style="{StaticResource FormStepText}"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Itens da nota" Style="{StaticResource FormSectionTitle}"/>
                                                <TextBlock x:Name="LblItensContagem" Text="Nenhum item" Style="{StaticResource FormSectionSubtitle}" Margin="0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid>
                                        <DataGrid x:Name="GridItens" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                                  CanUserAddRows="False" CanUserResizeRows="False" CanUserReorderColumns="False"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36"
                                                  HorizontalGridLinesBrush="#EEF2F7" BorderBrush="{StaticResource FormCardBorderBrush}"
                                                  BorderThickness="1" Background="White" RowBackground="White"
                                                  AlternatingRowBackground="#FAFBFD" MinHeight="150" MaxHeight="340"
                                                  VerticalScrollBarVisibility="Auto" MouseDoubleClick="GridItens_MouseDoubleClick"
                                                  KeyDown="GridItens_KeyDown">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="10,8"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="10,0"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="DataGridCell">
                                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.CellStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Posicao}" Width="44">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#94A3B8"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="90"/>
                                                <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="*" MinWidth="220">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="NCM" Binding="{Binding Ncm}" Width="86"/>
                                                <DataGridTextColumn Header="CFOP" Binding="{Binding Cfop}" Width="60"/>
                                                <DataGridTextColumn Header="QTD" Binding="{Binding QuantidadeFormatada}" Width="64">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="UN" Binding="{Binding Unidade}" Width="50"/>
                                                <DataGridTextColumn Header="VALOR UNIT." Binding="{Binding ValorUnitarioFormatado}" Width="104">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="TOTAL" Binding="{Binding ValorTotalFormatado}" Width="112">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Header="" Width="104">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Button Content="✏️" Style="{StaticResource RowIconButtonStyle}" ToolTip="Editar item"
                                                                        Click="BtnLinhaEditar_Click"/>
                                                                <Button Content="⧉" Style="{StaticResource RowIconButtonStyle}" ToolTip="Duplicar item"
                                                                        FontSize="14" Foreground="#475569" Click="BtnLinhaDuplicar_Click"/>
                                                                <Button Content="🗑" Style="{StaticResource RowIconButtonStyle}" ToolTip="Remover item"
                                                                        Foreground="#DC2626" Click="BtnLinhaRemover_Click"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Estado vazio -->
                                        <StackPanel x:Name="PainelItensVazio" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Margin="0,36,0,0" IsHitTestVisible="False">
                                            <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center" Opacity="0.55"/>
                                            <TextBlock Text="Nenhum item adicionado" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                            <TextBlock Text="Use “Adicionar item” ou “Do estoque”. Você pode lançar quantos precisar."
                                                       FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FormHint}" Margin="0,8,0,0"
                                               Text="Duplo clique edita · Delete remove o item selecionado"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. Pagamento e observações -->
                            <Border Style="{StaticResource FormSectionCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Style="{StaticResource FormStepBadge}"><TextBlock Text="4" Style="{StaticResource FormStepText}"/></Border>
                                        <TextBlock Text="Pagamento e informações adicionais" Style="{StaticResource FormSectionTitle}"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource FormField}">
                                            <TextBlock Text="Forma de pagamento" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="CbFormaPag" SelectedIndex="0">
                                                <ComboBoxItem Content="01 — Dinheiro" Tag="01"/>
                                                <ComboBoxItem Content="03 — Cartão de crédito" Tag="03"/>
                                                <ComboBoxItem Content="04 — Cartão de débito" Tag="04"/>
                                                <ComboBoxItem Content="17 — Pix" Tag="17"/>
                                                <ComboBoxItem Content="15 — Boleto" Tag="15"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource FormField}">
                                            <TextBlock Text="Informações complementares" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="TxtInfCpl" Style="{StaticResource ModernTextBox}" MaxLength="2000"/>
                                            <TextBlock Text="Saem no campo de dados adicionais da DANFE" Style="{StaticResource FormHint}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé: totais + ações -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" Padding="26,14"
                            CornerRadius="0,0,10,10" BorderBrush="{StaticResource FormCardBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,26,0">
                                    <TextBlock Text="ITENS" Style="{StaticResource TotalLabel}"/>
                                    <TextBlock x:Name="LblTotItens" Text="0" Style="{StaticResource TotalValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,26,0">
                                    <TextBlock Text="PRODUTOS" Style="{StaticResource TotalLabel}"/>
                                    <TextBlock x:Name="LblTotProdutos" Text="R$ 0,00" Style="{StaticResource TotalValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,26,0">
                                    <TextBlock x:Name="LblTotIcmsRotulo" Text="ICMS" Style="{StaticResource TotalLabel}"/>
                                    <TextBlock x:Name="LblTotIcms" Text="R$ 0,00" Style="{StaticResource TotalValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,26,0">
                                    <TextBlock Text="PIS / COFINS" Style="{StaticResource TotalLabel}"/>
                                    <TextBlock x:Name="LblTotPisCofins" Text="R$ 0,00" Style="{StaticResource TotalValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,26,0">
                                    <TextBlock Text="IBS / CBS" Style="{StaticResource TotalLabel}"/>
                                    <TextBlock x:Name="LblTotIbsCbs" Text="R$ 0,00" Style="{StaticResource TotalValue}"/>
                                </StackPanel>
                                <Border BorderBrush="{StaticResource FormCardBorderBrush}" BorderThickness="1,0,0,0" Padding="22,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL DA NOTA" Style="{StaticResource TotalLabel}"/>
                                        <TextBlock x:Name="LblTotNota" Text="R$ 0,00" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource TitleBrush}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnExcluirForm" Content="🗑  Excluir" Style="{StaticResource DangerButtonStyle}"
                                        Margin="0,0,16,0" Click="BtnExcluirForm_Click" Visibility="Collapsed"/>
                                <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                        Click="BtnFecharForm_Click"/>
                                <Button Content="💾  Salvar nota" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSalvar_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
