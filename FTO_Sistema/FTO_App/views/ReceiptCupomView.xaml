<UserControl x:Class="FTO_App.Views.ReceiptCupomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="302">

    <UserControl.Resources>
        <!-- TextRenderingMode/TextFormattingMode ficam SÓ no BorderCupom e são herdados daqui:
             setter de Style tem precedência sobre herança e travaria o modo de impressão
             (ClearType/Display são de tela; na térmica o texto sai esgarçado). -->
        <Style x:Key="CupomTexto" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CupomRotulo" TargetType="TextBlock" BasedOn="{StaticResource CupomTexto}">
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="CupomValor" TargetType="TextBlock" BasedOn="{StaticResource CupomTexto}">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <Style x:Key="CupomLinha" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CupomEmpresaDetalhe" TargetType="TextBlock" BasedOn="{StaticResource CupomTexto}">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CupomEmpresaTitulo" TargetType="TextBlock" BasedOn="{StaticResource CupomTexto}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="BorderCupom"
            Width="302"
            Background="White"
            Padding="14,12,14,14"
            HorizontalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            TextOptions.TextRenderingMode="ClearType"
            TextOptions.TextFormattingMode="Display">
        <StackPanel HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,10">
                <TextBlock x:Name="TxtEmpresaNome"
                           Style="{StaticResource CupomEmpresaTitulo}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="Black"/>
                <TextBlock x:Name="TxtEmpresaSubtitulo"
                           Style="{StaticResource CupomEmpresaTitulo}"
                           FontSize="8"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtEmpresaEndereco"
                           Style="{StaticResource CupomEmpresaDetalhe}"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtEmpresaCidade"
                           Style="{StaticResource CupomEmpresaDetalhe}"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtEmpresaTelefone"
                           Style="{StaticResource CupomEmpresaDetalhe}"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtEmpresaCnpj"
                           Style="{StaticResource CupomEmpresaDetalhe}"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtEmpresaIe"
                           Style="{StaticResource CupomEmpresaDetalhe}"
                           Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtCupomTitulo"
                           Style="{StaticResource CupomEmpresaTitulo}"
                           FontSize="8.5"
                           FontWeight="Bold"
                           Foreground="Black"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.15" Margin="0,0,0,9"/>

            <StackPanel Style="{StaticResource CupomLinha}">
                <TextBlock Text="Venda Nº:" Style="{StaticResource CupomRotulo}"/>
                <TextBlock x:Name="TxtNumeroVenda" Style="{StaticResource CupomValor}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CupomLinha}">
                <TextBlock Text="Data:" Style="{StaticResource CupomRotulo}"/>
                <TextBlock x:Name="TxtData" Style="{StaticResource CupomValor}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CupomLinha}">
                <TextBlock Text="Impresso em:" Style="{StaticResource CupomRotulo}"/>
                <TextBlock x:Name="TxtImpressoEm" Style="{StaticResource CupomValor}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource CupomLinha}" Margin="0,0,0,9">
                <TextBlock Text="Cliente:" Style="{StaticResource CupomRotulo}"/>
                <TextBlock x:Name="TxtCliente" Style="{StaticResource CupomValor}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.15" Margin="0,0,0,9"/>

            <StackPanel Margin="0,0,0,9">
                <TextBlock Text="Itens / descrição:" Style="{StaticResource CupomRotulo}" Margin="0,0,0,3"/>
                <TextBlock x:Name="TxtServico"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.15" Margin="0,0,0,6"/>

            <Border Height="2" Background="{DynamicResource PrimaryColor}" Margin="0,3,0,6"/>

            <StackPanel Style="{StaticResource CupomLinha}" Margin="0,3,0,9">
                <TextBlock Text="TOTAL:" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                <TextBlock x:Name="TxtTotal" FontSize="13" FontWeight="Bold" Foreground="Black" Margin="8,0,0,0"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.15" Margin="0,0,0,9"/>

            <TextBlock Text="PAGAMENTO" FontSize="8.5" FontWeight="Bold" Foreground="Black" Margin="0,2,0,6"/>

            <StackPanel Style="{StaticResource CupomLinha}" Margin="0,0,0,9">
                <TextBlock Text="Forma:" Style="{StaticResource CupomRotulo}"/>
                <TextBlock x:Name="TxtFormaPagamento" Style="{StaticResource CupomValor}"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.15" Margin="0,0,0,9"/>

            <TextBlock x:Name="TxtRodape"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Center"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Foreground="Black"
                       FontStyle="Italic"/>
        </StackPanel>
    </Border>
</UserControl>
