<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icons/fto.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Publish: apenas recursos pt-BR (remove pastas de idiomas no output). -->
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.96.0" />
    <PackageReference Include="Npgsql" Version="8.0.6" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <!-- .Core em vez do pacote completo: o SQLite só é lido pelo migrador legado
         (SqliteToPostgresMigrator) e o pacote completo arrasta o Entity Framework 6,
         que o app não usa (~6 MB no pacote de atualização). -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testes executam o script de atualização de verdade (UpdateService.BuildApplyUpdateScript). -->
    <InternalsVisibleTo Include="FTO_App.Tests" />
  </ItemGroup>

    <ItemGroup>
    <!-- Só Resource (embutido no assembly), NUNCA também Content.
         Quando o mesmo arquivo é Content, o WPF grava um AssemblyAssociatedContentFile e passa a
         resolver Icon="icons/fto.ico" e Source="/icons/fto.png" pelo ARQUIVO EM DISCO em vez do
         recurso embutido. Essa resolução depende do caminho do assembly de entrada, que é vazio
         num publish PublishSingleFile — e o MainWindow morria no load com
         "TypeConverterMarkupExtension iniciou uma exceção". Nada no código lê esses arquivos por
         caminho, então Content aqui era só duplicação. -->
    <Resource Include="icons/fto.png" />
    <Resource Include="icons/fto.ico" />
    <Content Include="Resources\nfse-logo-horizontal.png" Condition="Exists('$(MSBuildProjectDirectory)\Resources\nfse-logo-horizontal.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- .env é local/gitignored: só copia se existir (CI usa .env.example). -->
    <Content Include=".env" Condition="Exists('$(MSBuildProjectDirectory)\.env')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include=".env.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Após publish: remove pastas de idioma do runtime, mantém só pt-BR. -->
  <Target Name="PrunePublishLanguages" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -LiteralPath '$(PublishDir)' -Directory | Where-Object { $_.Name -match '^(cs|de|es|fr|it|ja|ko|pl|ru|tr|zh-Hans|zh-Hant)$' } | Remove-Item -Recurse -Force&quot;" />
  </Target>

</Project>